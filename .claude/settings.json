{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch policy…"
          }
        ]
      }
    ]
  }
}
